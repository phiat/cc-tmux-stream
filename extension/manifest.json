{
  "manifest_version": 2,
  "name": "tmux Stream",
  "version": "0.1.0",
  "description": "Stream tmux panes to Firefox sidebar for monitoring agent sessions",
  "browser_specific_settings": {
    "gecko": {
      "id": "tmux-stream@phiat.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": false
    }
  },
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },
  "permissions": [
    "storage"
  ],
  "sidebar_action": {
    "default_title": "tmux Stream",
    "default_panel": "sidebar/panel.html",
    "default_icon": "icons/icon-48.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "browser_style": true
  },
  "background": {
    "scripts": ["background.js"]
  }
}
