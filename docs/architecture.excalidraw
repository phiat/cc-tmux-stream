{
  "type": "excalidraw",
  "version": 2,
  "source": "tmux-stream",
  "elements": [
    {
      "id": "firefox-box",
      "type": "rectangle",
      "x": 50,
      "y": 100,
      "width": 280,
      "height": 300,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "firefox-label",
      "type": "text",
      "x": 130,
      "y": 110,
      "width": 120,
      "height": 25,
