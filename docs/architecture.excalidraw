      "strokeColor": "#c92a2a",
      "backgroundColor": "#ffe3e3",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "daemon-label",
      "type": "text",
      "x": 530,
      "y": 110,
      "width": 160,
      "height": 25,
      "text": "tmux-stream daemon",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "daemon-details",
      "type": "text",
      "x": 520,
      "y": 145,
      "width": 180,
      "height": 120,
      "text": "Rust / Tokio / Axum\n\n• WebSocket server\n• Token auth\n• Poll every 150ms\n• Route input keys",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "tmux-box",
      "type": "rectangle",
      "x": 500,
